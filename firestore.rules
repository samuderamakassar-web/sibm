rules_version = '2';

// ============================================================================
// Firestore Security Rules -- Portal SIBM
// ----------------------------------------------------------------------------
// Sebelum file ini ada, TIDAK ADA rules yang di-version-control untuk project
// ini sama sekali, dan tidak ada Firebase Authentication -- login lama cuma
// query Firestore + compare password PLAINTEXT di client, artinya siapa pun
// yang tahu config Firebase publik bisa baca/tulis SELURUH database TERMASUK
// PASSWORD tanpa rules eksplisit. Itu risiko paling kritis yang mendasari
// perubahan ini.
//
// Sekarang login sudah pakai Firebase Authentication sungguhan (lihat
// src/app/page.tsx, scripts/migrate-users-to-auth.mjs) dan password sudah
// TIDAK ADA LAGI di Firestore sama sekali (pindah ke penyimpanan ter-hash
// aman milik Firebase Auth sendiri) -- jadi risiko yang paling parah (bocor
// password massal) sudah TIDAK MUNGKIN terjadi lagi secara struktural,
// terlepas dari seberapa longgar rules collection lain di bawah ini.
//
// PENTING -- kenapa sebagian besar collection di bawah masih `if true`
// (bukan cuma isSignedIn()): src/app/page.tsx (portal utama "/") SENGAJA
// dibuka untuk SIAPA PUN tanpa login -- dashboard ringkasan (Ringkasan Hari
// Ini, Tren Aktivitas) dan form Menu Cepat (Lacak Tamu, Resi Paket, Request
// ATK, Lembur, Kerusakan/Helpdesk, Bahaya SBO) dipakai karyawan yang TIDAK
// PUNYA akun login (cukup pilih nama dari Master Data Karyawan) -- cuma staf
// operasional (OB/Security/Driver/QHSE/Admin GA) yang login lewat tombol
// "Staf Internal" buat masuk ke dashboard dept masing-masing. Percobaan
// mempersempit rules ini ke isSignedIn() untuk semua collection SEMPAT
// dilakukan lalu langsung di-revert di sesi yang sama karena mematahkan
// portal publik ini (dashboard ringkasan stuck "Memuat...", form Menu Cepat
// gak bisa submit) -- lihat analisis_project.md §28H untuk kronologinya.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // HELPER FUNCTIONS
    // --------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users_master/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users_master/$(request.auth.uid)).data;
    }

    // Substring case-insensitive, samakan dengan isAdministrator() di
    // src/hooks/useAuthGuard.ts -- "Administrator" maupun "Admin" lolos.
    function isAdmin() {
      return hasProfile() && myProfile().role.lower().matches('.*admin.*');
    }

    function myDept() {
      return hasProfile() ? myProfile().departemen : '';
    }

    // Ekspansi multi-daerah (25 Sep 2026): tiap akun users_master sekarang punya field
    // `daerah` (nama wilayah, mis. "Makassar", "Jakarta", dst). Nilai sentinel KHUSUS
    // 'PUSAT' menandai Super Admin -- lolos semua batasan wilayah, sama seperti isAdmin()
    // yang sudah lolos semua batasan role/dept. Admin biasa (role admin, daerah != 'PUSAT')
    // disebut "Admin Daerah" -- cuma boleh kelola akun & (nanti, bertahap) data di
    // daerahnya sendiri. Lihat analisis_project.md §56 untuk skema lengkap & rencana lanjutan.
    // .get('daerah', '') (bukan .daerah langsung) SENGAJA dipakai -- field ini BARU, akun
    // lama belum semuanya di-backfill lewat scripts/migrate-add-daerah.mjs. Akses field yang
    // gak ada lewat dot-notation bikin rule ERROR (dianggap deny), bukan graceful null.
    function myDaerah() {
      return hasProfile() ? myProfile().get('daerah', '') : '';
    }

    function isSuperAdmin() {
      return isAdmin() && myDaerah() == 'PUSAT';
    }

    // §108 Eksekutif Tenant (pihak tenant/eksternal): lihat saja, terbatas.
    function isEksekutif() {
      return hasProfile() && myProfile().get('departemen', '') == 'Eksekutif Tenant';
    }

    // Koleksi non-publik yang boleh dibaca Eksekutif Tenant (dashboard/eksekutif).
    function koleksiBacaEksekutif() {
      return ['okupansi_gedung', 'project_tracker'];
    }

    // --------------------------------------------------------------------
    // users_master -- read PUBLIC (dipakai portal utama tanpa login buat
    // foto profil staf & kontak Admin GA/QHSE -- data ini sendiri sudah
    // publik dari awal, dan field password sudah TIDAK ADA LAGI di sini
    // sama sekali). Write dibatasi admin -- satu-satunya bagian app yang
    // menulis ke sini cuma admin/users/page.tsx, jadi TIDAK ada fitur staf
    // biasa yang kepotong oleh pembatasan ini.
    // --------------------------------------------------------------------
    match /users_master/{uid} {
      allow read: if true;
      // Super Admin (daerah 'PUSAT') kelola akun MANA PUN. Admin Daerah biasa cuma boleh
      // buat/ubah/hapus akun yang daerah-nya SAMA PERSIS dengan daerah dia sendiri -- gak
      // bisa bikin akun buat daerah lain, gak bisa "pindahkan" akun ke daerah lain, gak
      // bisa hapus/edit akun daerah lain. Dipisah create/update/delete (bukan 1 `write`
      // gabungan) karena request.resource gak ada saat delete & resource gak ada saat create.
      // .get('daerah', '') dipakai buat AKUN LAMA yang belum di-backfill migrate-add-daerah.mjs
      // (dot-notation ke field yang gak ada bikin rule error/deny, bukan graceful null).
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.daerah == myDaerah());
      allow update: if isSuperAdmin() || (isAdmin() && resource.data.get('daerah', '') == myDaerah() && request.resource.data.daerah == myDaerah());
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.get('daerah', '') == myDaerah());
    }

    // --------------------------------------------------------------------
    // apar_units -- SENGAJA public read: dipakai halaman tanpa login
    // /qr-apar (src/app/qr-apar/page.tsx) yang discan dari QR fisik yang
    // ditempel di lokasi APAR, oleh siapa pun (bukan cuma karyawan login).
    // Write dibatasi (satu-satunya penulis: dashboard/security/inspeksi-apar
    // & admin/apar, keduanya SUDAH di belakang login lewat useAuthGuard).
    // --------------------------------------------------------------------
    match /apar_units/{unitId} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() || myDept() == 'Security');
    }

    // --------------------------------------------------------------------
    // SEMUA collection operasional lain (master/referensi + transaksional):
    // [RIWAYAT -- sejak §60 write sudah dibatasi, lihat blok di bawah] read & write TERBUKA -- sama seperti kondisi sebelum ada rules ini,
    // supaya portal publik tanpa login (lihat catatan panjang di atas) tetap
    // berfungsi penuh. Ini BUKAN pengunduran keamanan dibanding sebelumnya
    // (memang begini sejak awal, cuma sekarang eksplisit di rules bukan
    // implisit karena ketiadaan rules) -- perbaikan yang beneran penting
    // (password, users_master) tetap berlaku di atas.
    //
    // Pengetatan lebih lanjut per-collection/per-role (mis. staf cuma boleh
    // update tiket miliknya sendiri) butuh pemetaan lengkap semua alur kerja
    // dulu (banyak role -- OB, Security, Driver, Koordinator -- melakukan
    // update rutin sebagai bagian pekerjaan sehari-hari, bukan cuma admin),
    // supaya gak mematahkan fitur yang sedang dipakai tim secara aktif.
    // --------------------------------------------------------------------
    // Daftar collection operasional (master/referensi + transaksional).
    function koleksiOperasional() {
      return [
          'master_atk', 'master_kendaraan', 'employees_directory',
          'sop_documents', 'security_magang_directory', 'settings',
          'ob_settings', 'helpdesk_tickets', 'qhse_sbo_reports',
          'ga_atk_requests', 'ga_overtime_requests', 'security_visitor_logs',
          'packages', 'operational_vehicle_logs', 'driver_status_logs',
          'ob_checklists', 'ob_stock', 'ob_stock_logs', 'daily_plots',
          'inspeksi_fasilitas', 'apar_inspections', 'security_patrols',
          'kendaraan_odometer_logs', 'kendaraan_service_logs',
          'kendaraan_inspeksi_logs', 'kendaraan_uji_emisi',
          'deep_cleaning_tasks', 'notifikasi_patroli', 'notifikasi_kendaraan',
          'notifikasi_checklist_ob', 'security_monthly_schedules',
          'fcm_tokens', 'notifikasi_dadakan_siram', 'attendance_logs',
          'staff_points_bulanan', 'survei_kepuasan_gedung', 'security_shift_handover',
          'pengumuman_gedung', 'notifikasi_personal', 'security_shift_extend',
          'handbook_magang', 'evaluasi_manual', 'master_laptop', 'master_legalitas',
          // §59 Validasi Karyawan (Security) & Pemantauan Jam Kerja (QHSE)
          'validasi_karyawan', 'pemantauan_jam_kerja',
          // §80 Booking kendaraan & ruangan
          'booking',
          // §88 Okupansi gedung, §89 Anggaran & realisasi (khusus akun staf, tidak dibaca publik)
          'okupansi_gedung', 'anggaran', 'realisasi_biaya',
          // §106 RAB, §107 Project Tracker
          'anggaran_rab', 'project_tracker',
          // §113 Temuan inspeksi kondisi aset (bukan Helpdesk)
          'temuan_aset'
        ];
    }

    // Collection yang DITULIS portal publik TANPA login (src/app/page.tsx: form ATK, Lembur AC,
    // SBO, Lapor Kerusakan; SurveiKepuasanPage) -- cuma boleh MEMBUAT dokumen baru.
    function koleksiFormPublik() {
      return ['helpdesk_tickets', 'qhse_sbo_reports', 'ga_atk_requests', 'ga_overtime_requests', 'survei_kepuasan_gedung', 'booking'];
    }

    // Collection yang DIBACA portal publik tanpa login (src/app/page.tsx: Ringkasan, Pengumuman, Menu
    // Cepat (Lacak Tamu/Cek Paket/Lacak tiket/ATK per resi), Tren & Kalender (count), Status Operasional,
    // Tim Bertugas, Armada, Lembur; SurveiKepuasanPage: settings). attendance_logs ikut agar Tim Bertugas
    // tetap jalan bila FITUR_ABSENSI_AKTIF diaktifkan lagi. users_master & apar_units punya rule sendiri.
    function koleksiBacaPublik() {
      return [
          'settings', 'pengumuman_gedung', 'daily_plots', 'security_monthly_schedules',
          'employees_directory', 'master_atk', 'master_kendaraan',
          'operational_vehicle_logs', 'driver_status_logs', 'ga_overtime_requests', 'ga_atk_requests',
          'helpdesk_tickets', 'packages', 'security_visitor_logs', 'validasi_karyawan', 'attendance_logs',
          'booking'
        ];
    }

    // §60 Tahap 1 pengetatan: TULIS wajib akun staf terdaftar (hasProfile = users_master/{uid}
    // ada -- bukan sekadar isSignedIn(), karena akun Firebase Auth bisa dibuat sendiri lewat SDK).
    // Pengecualian: 5 form publik di atas boleh create tanpa login. BACA masih publik (portal
    // tanpa login membacanya) -- dibatasi di tahap berikutnya. Cron (firebase-admin) tidak terkena rules.
    match /{col}/{docId} {
      // §72 Tahap 2: BACA collection non-publik (patroli, SBO, poin, token FCM, survei, laptop,
      // legalitas, pemantauan jam kerja, notifikasi pribadi, dst.) wajib akun staf terdaftar.
      // §108 Eksekutif Tenant: akun read-only -- hanya koleksi publik + koleksiBacaEksekutif(), tanpa hak tulis.
      allow read: if col in koleksiOperasional() && (col in koleksiBacaPublik() || (hasProfile() && (!isEksekutif() || col in koleksiBacaEksekutif())));
      allow create: if col in koleksiOperasional() && (col in koleksiFormPublik() || (hasProfile() && !isEksekutif()));
      allow update, delete: if col in koleksiOperasional() && hasProfile() && !isEksekutif();
    }

    // --------------------------------------------------------------------
    // TODO (fitur mendatang, BELUM diimplementasikan -- lihat rencana user):
    //   - points_ledger / user_points  : sistem poin per karyawan
    //   - attendance                  : absensi check-in/out
    //   - survey_responses            : survei kepuasaan per laporan,
    //                                    kemungkinan ditulis lewat link
    //                                    email tanpa login -> butuh pola
    //                                    rules berbeda (token/ID acak, bukan
    //                                    isSignedIn()), didesain terpisah.
    // --------------------------------------------------------------------

    // Deny-by-default: collection baru yang belum ditambahkan secara
    // eksplisit di atas otomatis tertutup, bukan otomatis terbuka.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
