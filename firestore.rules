rules_version = '2';

// ============================================================================
// Firestore Security Rules -- Portal SIBM
// ----------------------------------------------------------------------------
// Sebelum file ini ada, TIDAK ADA rules yang di-version-control untuk project
// ini sama sekali, dan tidak ada Firebase Authentication -- login lama cuma
// query Firestore + compare password PLAINTEXT di client, artinya siapa pun
// yang tahu config Firebase publik bisa baca/tulis SELURUH database TERMASUK
// PASSWORD tanpa rules eksplisit. Itu risiko paling kritis yang mendasari
// perubahan ini.
//
// Sekarang login sudah pakai Firebase Authentication sungguhan (lihat
// src/app/page.tsx, scripts/migrate-users-to-auth.mjs) dan password sudah
// TIDAK ADA LAGI di Firestore sama sekali (pindah ke penyimpanan ter-hash
// aman milik Firebase Auth sendiri) -- jadi risiko yang paling parah (bocor
// password massal) sudah TIDAK MUNGKIN terjadi lagi secara struktural,
// terlepas dari seberapa longgar rules collection lain di bawah ini.
//
// PENTING -- kenapa sebagian besar collection di bawah masih `if true`
// (bukan cuma isSignedIn()): src/app/page.tsx (portal utama "/") SENGAJA
// dibuka untuk SIAPA PUN tanpa login -- dashboard ringkasan (Ringkasan Hari
// Ini, Tren Aktivitas) dan form Menu Cepat (Lacak Tamu, Resi Paket, Request
// ATK, Lembur, Kerusakan/Helpdesk, Bahaya SBO) dipakai karyawan yang TIDAK
// PUNYA akun login (cukup pilih nama dari Master Data Karyawan) -- cuma staf
// operasional (OB/Security/Driver/QHSE/Admin GA) yang login lewat tombol
// "Staf Internal" buat masuk ke dashboard dept masing-masing. Percobaan
// mempersempit rules ini ke isSignedIn() untuk semua collection SEMPAT
// dilakukan lalu langsung di-revert di sesi yang sama karena mematahkan
// portal publik ini (dashboard ringkasan stuck "Memuat...", form Menu Cepat
// gak bisa submit) -- lihat analisis_project.md §28H untuk kronologinya.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // HELPER FUNCTIONS
    // --------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users_master/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users_master/$(request.auth.uid)).data;
    }

    // Substring case-insensitive, samakan dengan isAdministrator() di
    // src/hooks/useAuthGuard.ts -- "Administrator" maupun "Admin" lolos.
    function isAdmin() {
      return hasProfile() && myProfile().role.lower().matches('.*admin.*');
    }

    function myDept() {
      return hasProfile() ? myProfile().departemen : '';
    }

    // --------------------------------------------------------------------
    // users_master -- read PUBLIC (dipakai portal utama tanpa login buat
    // foto profil staf & kontak Admin GA/QHSE -- data ini sendiri sudah
    // publik dari awal, dan field password sudah TIDAK ADA LAGI di sini
    // sama sekali). Write dibatasi admin -- satu-satunya bagian app yang
    // menulis ke sini cuma admin/users/page.tsx, jadi TIDAK ada fitur staf
    // biasa yang kepotong oleh pembatasan ini.
    // --------------------------------------------------------------------
    match /users_master/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --------------------------------------------------------------------
    // apar_units -- SENGAJA public read: dipakai halaman tanpa login
    // /qr-apar (src/app/qr-apar/page.tsx) yang discan dari QR fisik yang
    // ditempel di lokasi APAR, oleh siapa pun (bukan cuma karyawan login).
    // Write dibatasi (satu-satunya penulis: dashboard/security/inspeksi-apar
    // & admin/apar, keduanya SUDAH di belakang login lewat useAuthGuard).
    // --------------------------------------------------------------------
    match /apar_units/{unitId} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() || myDept() == 'Security');
    }

    // --------------------------------------------------------------------
    // SEMUA collection operasional lain (master/referensi + transaksional):
    // read & write TERBUKA -- sama seperti kondisi sebelum ada rules ini,
    // supaya portal publik tanpa login (lihat catatan panjang di atas) tetap
    // berfungsi penuh. Ini BUKAN pengunduran keamanan dibanding sebelumnya
    // (memang begini sejak awal, cuma sekarang eksplisit di rules bukan
    // implisit karena ketiadaan rules) -- perbaikan yang beneran penting
    // (password, users_master) tetap berlaku di atas.
    //
    // Pengetatan lebih lanjut per-collection/per-role (mis. staf cuma boleh
    // update tiket miliknya sendiri) butuh pemetaan lengkap semua alur kerja
    // dulu (banyak role -- OB, Security, Driver, Koordinator -- melakukan
    // update rutin sebagai bagian pekerjaan sehari-hari, bukan cuma admin),
    // supaya gak mematahkan fitur yang sedang dipakai tim secara aktif.
    // --------------------------------------------------------------------
    match /{col}/{docId} {
      allow read, write: if col in [
          'master_atk', 'master_kendaraan', 'employees_directory',
          'sop_documents', 'security_magang_directory', 'settings',
          'ob_settings', 'helpdesk_tickets', 'qhse_sbo_reports',
          'ga_atk_requests', 'ga_overtime_requests', 'security_visitor_logs',
          'packages', 'operational_vehicle_logs', 'driver_status_logs',
          'ob_checklists', 'ob_stock', 'ob_stock_logs', 'daily_plots',
          'inspeksi_fasilitas', 'apar_inspections', 'security_patrols',
          'kendaraan_odometer_logs', 'kendaraan_service_logs',
          'kendaraan_inspeksi_logs', 'kendaraan_uji_emisi',
          'deep_cleaning_tasks', 'notifikasi_patroli', 'notifikasi_kendaraan',
          'notifikasi_checklist_ob', 'security_monthly_schedules',
          'fcm_tokens'
        ];
    }

    // --------------------------------------------------------------------
    // TODO (fitur mendatang, BELUM diimplementasikan -- lihat rencana user):
    //   - points_ledger / user_points  : sistem poin per karyawan
    //   - attendance                  : absensi check-in/out
    //   - survey_responses            : survei kepuasaan per laporan,
    //                                    kemungkinan ditulis lewat link
    //                                    email tanpa login -> butuh pola
    //                                    rules berbeda (token/ID acak, bukan
    //                                    isSignedIn()), didesain terpisah.
    // --------------------------------------------------------------------

    // Deny-by-default: collection baru yang belum ditambahkan secara
    // eksplisit di atas otomatis tertutup, bukan otomatis terbuka.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
